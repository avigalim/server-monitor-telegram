# Copy to .env and fill in. Keep .env private: chmod 600 .env

# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-token

# Comma-separated Telegram user IDs (or group chat IDs) that receive alerts.
# Each person must press Start on the bot once before it can message them.
TELEGRAM_CHAT_IDS=111111111,222222222
