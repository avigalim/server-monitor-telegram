# Copy to .env and fill in. Keep .env private: chmod 600 .env

# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-token

# Comma-separated Telegram user IDs (or group chat IDs) that receive alerts.
# Each person must press Start on the bot once before it can message them.
TELEGRAM_CHAT_IDS=111111111,222222222

# Only for agent and central mode (see README.md, "Watching many servers").
# Generate a token with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# At least 16 characters. An agent needs AGENT_TOKEN. The central monitor needs the
# token of every agent: AGENT_TOKEN for all of them, or one variable per server,
# named by token_env in central.toml (for example AGENT_TOKEN_DB_01).
# AGENT_TOKEN=replace-with-a-long-random-string
