[Unit]
Description=Server monitor (Telegram alerts)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=servermon
WorkingDirectory=/opt/server-monitor
ExecStart=/usr/bin/python3 /opt/server-monitor/monitor.py
Restart=always
RestartSec=10
NoNewPrivileges=true
# Lets `ping` open a raw socket for the ping alert. Nothing else is granted.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

[Install]
WantedBy=multi-user.target
